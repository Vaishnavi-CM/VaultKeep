# Only needed for PRODUCTION deployment. Leave this file unused for local
# dev -- Vite's dev-server proxy (vite.config.js) already forwards /api
# requests to your local backend automatically.
#
# When you deploy, copy this to .env, set it to your deployed backend's
# URL + /api, and rebuild (npm run build).
VITE_API_URL=https://your-backend-url.onrender.com/api
